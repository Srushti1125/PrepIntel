# LLM Provider: 'gemini' or 'groq'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ingestion alternates Gemini and Groq; set both keys to enable rate-limit fallback.
# LLM_PROVIDER controls chat only. Ingestion uses both configured providers.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PDF_INPUT_DIR=Interview_Experiences
CHROMA_PERSIST_DIR=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- optional tuning (defaults shown) ---
# LLM_PROVIDER=gemini
# DATA_DIR=data
# RETRIEVAL_MAX_DISTANCE=0.85     # cosine distance cut-off; empty = no cut-off
# MAX_ANSWER_RETRIES=1
# CITATION_MIN_SUPPORT=0.5
# OCR_ENABLED=false               # needs the Tesseract binary + pytesseract
# CHROMA_CLOUD_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=
