# Copy these into: Streamlit Community Cloud -> App -> Settings -> Secrets
# (or into .streamlit/secrets.toml for local runs; that file is git-ignored)
# For Gemini:
# LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-2.5-flash"

# For Groq:
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "your-groq-api-key"
# GROQ_MODEL = "llama-3.3-70b-versatile"

# Optional: Chroma Cloud instead of a bundled ./chroma_db folder
# CHROMA_CLOUD_API_KEY = ""
# CHROMA_TENANT = ""
# CHROMA_DATABASE = ""
