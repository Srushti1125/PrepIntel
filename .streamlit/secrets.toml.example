# Copy these into: Streamlit Community Cloud -> App -> Settings -> Secrets
# (or into .streamlit/secrets.toml for local runs; that file is git-ignored)
# For Gemini:
# LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-2.5-flash"

# For ingestion alternation/fallback, provide both provider keys.
GROQ_API_KEY = "" # add your Groq key to enable ingestion fallback
GROQ_MODEL = "llama-3.3-70b-versatile"
# LLM_PROVIDER controls the chat provider; ingestion uses both configured keys.

# Optional: Chroma Cloud instead of a bundled ./chroma_db folder
# CHROMA_CLOUD_API_KEY = ""
# CHROMA_TENANT = ""
# CHROMA_DATABASE = ""
